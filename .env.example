# Copia este fichero como ".env" para trabajar en tu ordenador.
# En producción estas variables se ponen en el panel del alojamiento, no en un fichero.

DEBUG=1
# SECRET_KEY=            # obligatorio en producción (Render la genera sola)
# DATABASE_URL=postgres://usuario:clave@host:5432/nombre     # sin esto se usa SQLite en var/db.sqlite3

# --- Usuario de gestión que se crea al arrancar ---
TLV_ADMIN_EMAIL=gestion@ejemplo.com
TLV_ADMIN_PASSWORD=cambia-esta-clave

# --- Motor de voz ---
# Sin ELEVENLABS_API_KEY se usa el motor simulado (no clona, pero deja probar todo el flujo).
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io      # residencia UE (Enterprise): https://api.eu.residency.elevenlabs.io

# --- Correo (cualquier proveedor SMTP). Sin EMAIL_HOST los correos salen por la consola. ---
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Todas las Voces <hola@tudominio.com>

# --- Dirección pública (enlaces de los correos y QR de los certificados) ---
# TLV_SITE_URL=https://www.tudominio.com
# ALLOWED_HOSTS=www.tudominio.com,tudominio.com

# --- Claves que NO deben cambiar nunca una vez en producción ---
# TLV_WATERMARK_KEY=     # clave de la marca de agua (si se cambia, no se leen los audios antiguos)
# TLV_SIGNING_SEED=      # semilla de la firma del registro de trazabilidad
# TLV_MEDIA_ROOT=/var/data/media     # carpeta (disco persistente) de grabaciones y audios
